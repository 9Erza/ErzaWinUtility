<UserControl x:Class="ErzaWinUtility.MVVM.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="750">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Application Installer" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Select software to install automatically via Windows Package Manager (Winget)." 
                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,25"/>

            <TextBlock Text="BROWSERS" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Background="{StaticResource BgPanel}" CornerRadius="12" BorderBrush="{StaticResource BorderCol}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <UniformGrid Columns="2">
                    <CheckBox x:Name="ChromeCheck" Content="Google Chrome" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                    <CheckBox x:Name="BraveCheck" Content="Brave Browser" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                    <CheckBox x:Name="FirefoxCheck" Content="Mozilla Firefox" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                    <CheckBox x:Name="OperaCheck" Content="Opera GX" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                </UniformGrid>
            </Border>

            <TextBlock Text="TOOLS &amp; DEVELOPMENT" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Background="{StaticResource BgPanel}" CornerRadius="12" BorderBrush="{StaticResource BorderCol}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <UniformGrid Columns="2">
                    <CheckBox x:Name="VsCodeCheck" Content="Visual Studio Code" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                    <CheckBox x:Name="GitCheck" Content="Git for Windows" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                    <CheckBox x:Name="SevenZipCheck" Content="7-Zip" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                    <CheckBox x:Name="DiscordCheck" Content="Discord" Foreground="White" Margin="5" Style="{StaticResource ModernToggleStyle}"/>
                </UniformGrid>
            </Border>

            <Button x:Name="BtnInstall" Content="Install Selected Apps" Height="45" Width="220" 
                    HorizontalAlignment="Right" Background="{StaticResource AccentBlue}" 
                    Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnInstall_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>