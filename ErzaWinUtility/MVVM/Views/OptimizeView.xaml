<UserControl x:Class="ErzaWinUtility.MVVM.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="750">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="System Optimization" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

            <Border Background="{StaticResource BgPanel}" CornerRadius="12" BorderBrush="{StaticResource BorderCol}" BorderThickness="1" Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Erza Ultimate Power Plan" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Import a customized power profile for maximum performance and minimum latency." 
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,20,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="BtnInstallPlan" Content="Install Plan" Width="130" Height="35"
                            Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" Cursor="Hand"
                            Click="BtnInstallPlan_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Border Background="#1A1111" CornerRadius="12" BorderBrush="#FF4C4C" BorderThickness="1" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Safety Configuration" Foreground="#FF4C4C" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Modifying system settings can be risky. We strongly recommend creating a restore point first." 
                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,15"/>
                    <Grid>
                        <Button x:Name="BtnCreateRestore" Content="Create Restore Point" HorizontalAlignment="Left" 
                                Width="180" Height="35" Background="#33FF4C4C" Foreground="White" BorderBrush="#FF4C4C"
                                Click="BtnCreateRestore_Click"/>

                        <CheckBox x:Name="CheckSafetyLock" Content="I have created a restore point and I know what I'm doing" 
                                  Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="CheckSafetyLock_Changed" Unchecked="CheckSafetyLock_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="TweaksContainer" Background="{StaticResource BgPanel}" CornerRadius="12" 
                    BorderBrush="{StaticResource BorderCol}" BorderThickness="1" Padding="20" Opacity="0.3" IsEnabled="False">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="System Tweaks" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Recommended" Click="BtnProfileRecommended_Click" Style="{StaticResource ActionButtonStyle}" Width="110" Margin="5,0"/>
                            <Button Content="Select All" Click="BtnProfileAll_Click" Style="{StaticResource ActionButtonStyle}" Width="90" Margin="5,0"/>
                            <Button Content="Clear All" Click="BtnProfileClear_Click" Style="{StaticResource ActionButtonStyle}" Width="90" Margin="5,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="TweaksList">
                        <CheckBox x:Name="TweakTempFiles" Content="Delete Temporary Files" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakActivityHistory" Content="Disable Activity History" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakConsumerFeatures" Content="Disable Consumer Features" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakFolderDiscovery" Content="Disable Automatic Folder Discovery" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakLocation" Content="Disable Location Tracking" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakTelemetry" Content="Disable System Telemetry" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakWPBT" Content="Disable WPBT (Bios Bloatware)" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakEndTask" Content="Enable Taskbar End Task" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakWidgets" Content="Remove Windows Widgets" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakDiskCleanup" Content="Run Disk Cleanup" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakServices" Content="Set Services to Manual" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakCopilot" Content="Disable Microsoft Copilot" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakEdge" Content="Edge Browser Debloat" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakOneDrive" Content="Remove OneDrive" Foreground="White" Margin="0,8" />
                        <CheckBox x:Name="TweakClassicMenu" Content="Set Classic Right-Click Menu" Foreground="White" Margin="0,8" />
                    </StackPanel>

                    <Button x:Name="BtnRunTweaks" Content="Run Selected Tweaks" Margin="0,20,0,0" 
                            Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold" Height="45"
                            Cursor="Hand" Click="BtnRunTweaks_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>