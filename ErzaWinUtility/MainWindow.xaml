<Window x:Class="ErzaWinUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erza Win Utility" Height="650" Width="1000"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource BgMain}" 
            CornerRadius="15" 
            BorderBrush="{StaticResource BorderCol}" 
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="15,0,0,15">
                <StackPanel Margin="10,20">
                    <TextBlock Text="ERZA UTILITY" 
                               Foreground="{StaticResource AccentBlue}" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>

                    <RadioButton Content="App Installer"
                                 Style="{StaticResource NavButtonStyle}"
                                 Click="NavInstall_Click"/>

                    <RadioButton Content="System Optimization"
                                 Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True"
                                 Click="NavOptimize_Click"/>

                    <RadioButton Content="Additional Config"
                                 Style="{StaticResource NavButtonStyle}"
                                 Click="NavConfig_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnMinimize" Content="_" Width="40" Background="Transparent" Foreground="White" BorderThickness="0"/>
                        <Button x:Name="BtnClose" Content="X" Width="40" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="ViewContainer" Grid.Row="1" Margin="20"/>

                <Border Grid.Row="2" Background="#0A0A0F" CornerRadius="10" Margin="20,10,20,20" BorderBrush="#20202A" BorderThickness="1">
                    <ScrollViewer x:Name="LogScrollViewer">
                        <TextBlock x:Name="StatusLog" 
                                   Text="> System Ready..." 
                                   Foreground="#4A7FD4" 
                                   FontFamily="Consolas" 
                                   FontSize="11" 
                                   Margin="12" 
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>