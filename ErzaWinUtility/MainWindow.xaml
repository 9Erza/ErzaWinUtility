<Window x:Class="ErzaWinUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erza Win Utility" Height="700" Width="1000"
        Background="#12121B" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen">

    <Border CornerRadius="15" Background="#12121B" BorderThickness="1" BorderBrush="#2A2A38">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="#181824">
                <TextBlock Text="ERZA UTILITY" Foreground="#4A7FD4" FontSize="22" FontWeight="Bold" Margin="25,30,0,40"/>

                <RadioButton Content="Optimization" Style="{StaticResource MenuButtonStyle}" IsChecked="True" Click="NavOptimize_Click"/>
                <RadioButton Content="Configuration" Style="{StaticResource MenuButtonStyle}" Click="NavConfig_Click"/>
                <RadioButton Content="App Installer" Style="{StaticResource MenuButtonStyle}" Click="NavInstall_Click"/>

                <Button Content="Exit" Click="Exit_Click" Margin="20,100,20,0" Height="35" Style="{StaticResource PrimaryButton}" Background="#3D2A2A"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="MainFrame" Margin="20"/>

                <Border Grid.Row="1" Background="#0C0C12" BorderThickness="0,1,0,0" BorderBrush="#2A2A38">
                    <TextBox x:Name="LogTerminal" Background="Transparent" Foreground="#A0A0B8" 
                             BorderThickness="0" IsReadOnly="True" Margin="10" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>